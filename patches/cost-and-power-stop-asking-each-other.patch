+// A permanent effect only reaches cards in the zones its target names, and a "self" effect
+// only its own card. Checking that before the effect's conditions keeps cost and power from
+// asking each other in circles: LittleOars Jr. (OP16-017) asks every Character's cost for
+// its power, and Thatch (OP16-005) asks every Character's power for a discount that only
+// applies to itself in hand. Evaluated blindly, each question fans out into the other until
+// a full board takes minutes to settle.
+function couldReach(
+  state: MatchState,
+  source: CardInstance,
+  target: { self?: boolean; zones?: readonly string[] },
+  targetInstanceId: string,
+): boolean {
+  if (target.self && source.instanceId !== targetInstanceId) return false;
+  const zone = state.cards[targetInstanceId]?.zone;
+  return !target.zones || !zone || target.zones.includes(zone);
+}
+
 export function getContinuousCardCost(
   state: MatchState,
   targetInstanceId: string,
@@ -812,7 +829,8 @@ export function getContinuousCardCost(
         action.action === "modifyCost" &&
         !action.paymentOnly &&
         (!inHand || action.target.self) &&
-        (action.target.count.amount === "all" || action.target.self)
+        (action.target.count.amount === "all" || action.target.self) &&
+        couldReach(state, source, action.target, targetInstanceId)
           ? [{ source, effect, action, value: 0 }]
           : [],
       ),
@@ -892,8 +910,10 @@ export function getPermanentModifierTotal(
       }
 
       for (const effect of card.effects?.permanentEffects ?? []) {
-        const relevantActions = effect.actions.filter((action) =>
-          actionIsDynamicModifier(action, type),
+        const relevantActions = effect.actions.filter(
+          (action) =>
+            actionIsDynamicModifier(action, type) &&
+            (!("target" in action) || couldReach(state, source, action.target, targetInstanceId)),
         );
