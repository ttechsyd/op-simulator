+import { expect, test } from "vite-plus/test";
+import { OnePieceTestEngine } from "../../src/index.ts";
+
+// LittleOars Jr. (OP16-017) reads every Character's cost for its own power; Thatch
+// (OP16-005) reads every Character's power for a discount that only applies to itself in
+// hand. Before effects were checked for reach ahead of their conditions, each read fanned
+// out into the other and this play from a real Red Ace game ran for minutes.
+test.each([
+  // Thatch on the field is a cost 8 Whitebeard Pirates Character, so the -4000 is off
+  { board: ["OP16-010", "OP16-004", "OP16-005", "OP16-005"], power: 8000 },
+  // Curiel tops out at cost 7 and Thatch only sits in hand, so the -4000 holds
+  { board: ["OP16-010", "OP16-004"], power: 4000 },
+])("playing LittleOars Jr. beside $board.length Characters settles at once", ({ board, power }) => {
+  const e = OnePieceTestEngine.create(
+    {
+      leaderCardId: "OP16-001",
+      character: board,
+      hand: ["OP16-017", "OP16-005", "OP16-005", "OP17-005", "OP16-003"],
+      activeDon: 6,
+    },
+    {
+      leaderCardId: "OP14-020",
+      character: ["ST32-002", "OP12-034", "OP12-023", "OP13-031", "OP13-031"],
+    },
+  );
+  const started = performance.now();
+  e.asSouth().play("OP16-017");
+  expect(performance.now() - started).toBeLessThan(2000);
+  const oars = e.getView("south").players.south.characters.find((c) => c?.cardId === "OP16-017");
+  expect(oars?.power).toBe(power);
+});
