+// Whether one card is in a target's reach. Filters are asked about that card alone: a filter
+// on a value the asking effect feeds (Linlin sets base power by base power) would otherwise
+// re-read every other candidate, and each of those reads every other one again.
+export function targetReaches(
+  state: MatchState,
+  controller: MatchSeat,
+  sourceInstanceId: string | null,
+  target: Target,
+  instanceId: string,
+): boolean {
+  const pool = candidatePoolForTarget(state, controller, sourceInstanceId, { ...target, filters: undefined });
+  if (!pool.candidateIds.includes(instanceId)) return false;
+  return (target.filters ?? []).every((filter) => {
+    const result = matchesTargetFilter(state, sourceInstanceId, instanceId, filter);
+    return result.supported && result.matches;
+  });
+}
+
 export function candidatePoolForTarget(
   state: MatchState,
   controller: MatchSeat,
diff --git a/submodules/one-piece/packages/engine/tests/rules/06-base-power-fan-out.test.ts b/submodules/one-piece/packages/engine/tests/rules/06-base-power-fan-out.test.ts
new file mode 100644
index 00000000..3c9e47cf
--- /dev/null
+++ b/submodules/one-piece/packages/engine/tests/rules/06-base-power-fan-out.test.ts
@@ -0,0 +1,21 @@
+import { expect, test } from "vite-plus/test";
+import { OnePieceTestEngine } from "../../src/index.ts";
+
+// Charlotte Linlin (OP17-112) sets the base power of Characters by their base power. Each
+// check used to re-read every other Character's base power, and those every other one's.
+test("playing Charlotte Linlin beside trigger Characters settles at once", () => {
+  const e = OnePieceTestEngine.create(
+    {
+      leaderCardId: "OP09-062",
+      character: ["OP04-106", "OP04-108", "OP04-067", "OP05-073"],
+      hand: ["OP17-112"],
+      activeDon: 10,
+    },
+    { leaderCardId: "OP16-079", character: ["OP04-106", "OP04-108", "OP04-067", "OP05-073", "OP04-069"] },
+  );
+  const started = performance.now();
+  e.asSouth().play("OP17-112");
+  expect(performance.now() - started).toBeLessThan(2000);
+  const bavarois = e.getView("south").players.south.characters.find((c) => c?.cardId === "OP04-106");
+  expect(bavarois?.power).toBe(8000);
+});
