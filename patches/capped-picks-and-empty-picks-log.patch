diff --git a/submodules/one-piece/packages/engine/tests/rules/05-total-cost-cap.test.ts b/submodules/one-piece/packages/engine/tests/rules/05-total-cost-cap.test.ts
new file mode 100644
index 00000000..f28dce53
--- /dev/null
+++ b/submodules/one-piece/packages/engine/tests/rules/05-total-cost-cap.test.ts
@@ -0,0 +1,19 @@
+import { expect, test } from "vite-plus/test";
+import { OnePieceTestEngine } from "../../src/index.ts";
+
+// Loki (OP17-119) K.O.s Characters with a total cost of 4 or less. A Character that costs
+// more than 4 on its own can never be part of that, so it must not be offered; the bots
+// used to pick it and have the answer refused.
+test("Loki only offers Characters that fit under the total cost", () => {
+  const e = OnePieceTestEngine.create(
+    { leaderCardId: "OP17-079", hand: ["OP17-119"], activeDon: 6 },
+    { leaderCardId: "OP14-020", character: ["OP17-119", "OP04-106", "OP04-108"] },
+  );
+  e.asSouth().play("OP17-119");
+  e.acceptLeadingOptional("south");
+  const prompt = e.getState().promptQueue.find((p) => p.resolutionContext?.intent === "effectTargetSelection");
+  expect(prompt).toBeDefined();
+  const offered = prompt!.options.map((o) => e.getState().cards[o.targetId!]!.cardId);
+  expect(offered).not.toContain("OP17-119");
+  expect(offered.length).toBeGreaterThan(0);
+});
